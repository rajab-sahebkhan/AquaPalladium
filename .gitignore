# Project datasets and generated analysis outputs
# Ignore raw data by default, except the dashboard dataset
data/raw/*
!data/raw/
!data/raw/desalination_sensor_data.csv

# Ignore processed data
data/processed/

# Ignore generated outputs by default, except dashboard-required reports
outputs/*
!outputs/
!outputs/stable_anomaly_investigation/
